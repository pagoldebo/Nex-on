# ==============================================================================
# Nex-on Enterprise — Hardened Production Nginx Server Block (L-03 Remediation)
# ==============================================================================
# Document Root MUST be pointed strictly at the `public/` directory.
# NEVER point Nginx root at the parent project directory.

server {
    listen 80;
    listen [::]:80;
    server_name nexon.app www.nexon.app;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name nexon.app www.nexon.app;

    # SSL Certificates (managed via Certbot or custom TLS)
    ssl_certificate /etc/letsencrypt/live/nexon.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nexon.app/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Strict Web Root (Only the public subdirectory is accessible)
    root /var/www/nexon/public;
    index index.php index.html;

    charset utf-8;

    # 1. Block access to hidden files and dotfiles (e.g., .env, .git, .htaccess)
    location ~ /\.(?!well-known).* {
        deny all;
        access_log off;
        log_not_found off;
    }

    # 2. Block direct access to sensitive framework directories if mis-rooted
    location ~* ^/(app|bootstrap|config|database|lang|resources|routes|scripts|storage|tests|vendor)/ {
        deny all;
        return 404;
    }

    # 3. Prevent PHP script execution in the uploaded public media directories
    location ^~ /images/ {
        location ~* \.(php|phtml|phar|php[0-9]*|pl|py|cgi|sh|bash)$ {
            deny all;
            return 403;
        }
        try_files $uri =404;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    # 4. Standard Static Asset Caching
    location ~* \.(css|js|avif|webp|svg|png|jpg|jpeg|gif|ico|woff|woff2|ttf|eot)$ {
        expires 30d;
        access_log off;
        add_header Cache-Control "public, max-age=2592000, immutable";
        try_files $uri =404;
    }

    # 5. Front Controller Routing
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # 6. PHP FastCGI execution (Restricted strictly to index.php)
    location ~ \.php$ {
        # Mitigate httpoxy vulnerability
        fastcgi_param HTTP_PROXY "";

        fastcgi_pass unix:/var/run/php/php8.2-fpm.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;

        # Timeouts and buffer sizes
        fastcgi_read_timeout 60s;
        fastcgi_buffer_size 128k;
        fastcgi_buffers 4 256k;
        fastcgi_busy_buffers_size 256k;
    }

    # 7. Disallow favicon and robots.txt missing file logging
    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    # 8. Maximum Request Body Size (for product & batch asset uploads)
    client_max_body_size 25M;
}
